# ONewPipe server configuration (/etc/default/onewpipe-server)
# Edit this file then run:  sudo systemctl restart onewpipe-server

# Address and TCP port of the web server.
PORT=8080
HOST=0.0.0.0

# Directory where accounts and watch states are persisted.
DATA_DIR=/var/lib/onewpipe-server

# Set a long random value before exposing the server beyond localhost,
# then uncomment the line and restart the service.
#JWT_SECRET=change-me-to-a-long-random-string

# Optional geo-localization of trending and search results.
#CONTENT_COUNTRY=FR
#CONTENT_LANGUAGE=fr

# JVM options (systemd word-splits this value into arguments).
JAVA_OPTS=-Xms64m -Xmx512m
