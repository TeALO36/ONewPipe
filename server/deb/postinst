#!/bin/sh
# Maintainer script: enable and start the service after install/upgrade.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if systemctl enable onewpipe-server.service >/dev/null 2>&1; then
        if ! systemctl start onewpipe-server.service; then
            echo "Warning: could not start onewpipe-server; check 'systemctl status onewpipe-server'." >&2
        fi
    else
        echo "Warning: could not enable onewpipe-server at boot; run 'systemctl enable onewpipe-server'." >&2
    fi
else
    echo "systemd is not running: enable the service with 'systemctl enable --now onewpipe-server' once the system is booted."
fi

exit 0
